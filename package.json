{
  "name": "obsidian-btw",
  "version": "0.0.2",
  "private": true,
  "description": "turn your obsidian into an ide",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "bun run build.ts --watch",
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "fix": "oxfmt -c config/oxfmt.json && oxlint -c config/oxlint.json --fix && tsc --noEmit",
    "release": "bun run release.ts"
  },
  "dependencies": {
    "@electron/rebuild": "^4.0.4",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "5.5.0",
    "node-pty": "^1.1.0",
    "obsidian": "^1.11.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.0.3",
    "oxfmt": "^0.20.0",
    "oxlint": "^1.35.0",
    "typescript": "^5.0.0"
  }
}
